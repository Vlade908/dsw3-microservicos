generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pedido {
  id            String   @id @default(uuid())
  produtoId     String
  nomeProduto   String
  precoUnitario Float
  quantidade    Int
  valorTotal    Float
  dataPedido    DateTime @default(now())
  status        String   @default("REALIZADO")
}

// Cache local replicado via Event Broker (Materialized View para alta resiliência)
model ProdutoCache {
  id        String   @id
  nome      String
  preco     Float
  estoque   Int
  descricao String?
  updatedAt DateTime @updatedAt
}

